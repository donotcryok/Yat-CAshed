# ============================================================
# Yat-CAshed 行尾与二进制文件归一化规则
# ------------------------------------------------------------
# 背景：本仓库的 linux-6.8-main/ 整树曾以 CRLF 检入
#       （81147/82038 个文件），导致 `make tinyconfig`
#       在 init/Kconfig:9 直接报 syntax error。
#
# 策略：
#   1. 默认所有文本文件在**仓库内**统一存为 LF，
#      检出于工作区时也按 LF（eol=lf），避免跨平台漂移。
#   2. 明确声明二进制文件，禁止 Git 做任何行尾转换，
#      否则会损坏图片/压缩包/字体等。
#   3. 内核源码树（linux-6.8-main/）上游即 LF，单独强化一遍。
#
# 生效方式：
#   已有工作区若仍是 CRLF，需执行一次归一化：
#     git add --renormalize .
#   或按 .gitattributes 重写工作区：
#     git rm --cached -r . && git reset --hard
# ============================================================

# ---------- 默认：文本文件统一 LF ----------
* text=auto eol=lf

# ---------- 明确的二进制类型（禁止行尾转换）----------
*.png       binary
*.jpg       binary
*.jpeg      binary
*.gif       binary
*.bmp       binary
*.ico       binary
*.svg       binary
*.pdf       binary
*.pptx      binary
*.docx      binary
*.xlsx      binary
*.zip       binary
*.gz        binary
*.xz        binary
*.bz2       binary
*.7z        binary
*.tar       binary
*.jar       binary
*.class     binary
*.o         binary
*.a         binary
*.so        binary
*.exe       binary
*.dll       binary
*.woff      binary
*.woff2     binary
*.ttf       binary
*.otf       binary
*.ttc       binary
*.eot       binary
*.pyc       binary

# ---------- 内核源码树：上游即 LF，强化 ----------
# 注意：gitattributes 规则「后面的覆盖前面的」。因此必须先给出内核树
# 的通用 text 规则，再给出其中的二进制例外，顺序不能颠倒。
linux-6.8-main/**                text eol=lf
linux-6.8-main/**/*.S            text eol=lf
linux-6.8-main/**/*.s            text eol=lf
linux-6.8-main/**/*.c            text eol=lf
linux-6.8-main/**/*.h            text eol=lf
linux-6.8-main/**/Kconfig*       text eol=lf
linux-6.8-main/**/Makefile*      text eol=lf
linux-6.8-main/**/*.rst          text eol=lf
linux-6.8-main/**/*.yaml         text eol=lf
linux-6.8-main/**/*.dts          text eol=lf
linux-6.8-main/**/*.dtsi         text eol=lf
linux-6.8-main/**/*.lds          text eol=lf

# 内核树内的二进制「例外」——必须排在上面通用规则之后才生效。
# tools/perf/tests/pe-file.exe(.debug) 是 PE/COFF 解析测试的固件，
# 若被转成 LF 会破坏测试；bpf 的 .bin、dtb、固件同理。
linux-6.8-main/**/*.exe          binary
linux-6.8-main/**/*.exe.debug    binary
linux-6.8-main/**/*.bin          binary
linux-6.8-main/**/*.dtb          binary
linux-6.8-main/**/*.dtbo         binary
linux-6.8-main/**/*.so           binary
linux-6.8-main/**/*.a            binary
linux-6.8-main/**/*.o            binary
linux-6.8-main/**/*.ko           binary
linux-6.8-main/**/*.gz           binary
linux-6.8-main/**/*.xz           binary
linux-6.8-main/**/*.bz2          binary
linux-6.8-main/**/*.lz4          binary
linux-6.8-main/**/*.lzma         binary
linux-6.8-main/**/*.lzo          binary
linux-6.8-main/**/*.zst          binary
linux-6.8-main/**/*.png          binary
linux-6.8-main/**/*.jpg          binary
linux-6.8-main/**/*.gif          binary
linux-6.8-main/**/*.pdf          binary
linux-6.8-main/**/*.rlib         binary
linux-6.8-main/**/*.rmeta        binary

# ---------- 脚本必须保持 LF，否则 shebang 失效 ----------
*.sh        text eol=lf
*.bash      text eol=lf
*.py        text eol=lf
*.pl        text eol=lf
*.pm        text eol=lf

# ---------- Windows 专用脚本保留 CRLF ----------
*.bat       text eol=crlf
*.cmd       text eol=crlf
*.ps1       text eol=crlf
