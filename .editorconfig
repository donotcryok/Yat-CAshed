# Yat-CAShed 统一编辑器配置
# https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

# 内核 / C 代码：Linux 内核规范使用 Tab
[*.{c,h}]
indent_style = tab
indent_size = 8

[linux-6.8-main/**/*.{c,h}]
indent_style = tab
indent_size = 8

# Kernel 构建脚本
[Kconfig*]
indent_style = tab

[Makefile]
indent_style = tab

[*.{py}]
indent_style = space
indent_size = 4

[*.{java}]
indent_style = space
indent_size = 4

[*.{md,markdown}]
indent_style = space
indent_size = 2

[*.{yml,yaml}]
indent_style = space
indent_size = 2

[*.{json}]
indent_style = space
indent_size = 2

[*.sh]
indent_style = space
indent_size = 4

# 保持原样，勿自动处理
[*.{jar,class,png,jpg,jpeg,pdf,docx,pptx,cpio.gz,bin}]
insert_final_newline = false
trim_trailing_whitespace = false
