# SPDX-License-Identifier: GPL-2.0-only
#
# NOTE! Don't add files that are generated in specific
# subdirectories here. Add them in the ".gitignore" file
# in that subdirectory instead.
#
# NOTE! Please use 'git ls-files -i -c --exclude-per-directory=.gitignore'
# command after changing this file, to see if there are
# any tracked files which get ignored after the change.
#
# Normal rules (sorted alphabetically)
#
.*
*.a
*.asn1.[ch]
*.bin
*.bz2
*.c.[012]*.*
*.dt.yaml
*.dtb
*.dtbo
*.dtb.S
*.dtbo.S
*.dwo
*.elf
*.gcno
*.gz
*.i
*.ko
*.lex.c
*.ll
*.lst
*.lz4
*.lzma
*.lzo
*.mod
*.mod.c
*.o
*.o.*
*.patch
*.rmeta
*.rpm
*.rsi
*.s
# NOTE: 内核汇编源文件使用大写 .S。原规则 `*.s` 在大小写不敏感
# 文件系统上（Windows/macOS + core.ignorecase）会连带忽略 .S，
# 曾导致本仓库 1326 个 .S 汇编源文件全部未入库，vmlinux 无法链接。
# 显式否定之，见 docs/CONFLICT_ANALYSIS.md §8.5。
!*.S
# 上面 !*.S 会让开头的 `.*` 规则对以点开头的 .S 失效，于是 kallsyms 的
# 临时汇编产物（script/kallsyms.c 生成的 .tmp_vmlinux.kallsymsN.S）会出现在
# git status 里。gitignore 是后者覆盖前者，故在其后单独压回。
# 注意这里只压 .tmp_ 前缀，不影响任何真实的 .S 源文件。
.tmp_*.syms
.tmp_*.S
*.so
*.so.dbg
*.su
*.symtypes
*.symversions
*.tab.[ch]
*.tar
*.xz
*.zst
Module.symvers
modules.order

#
# Top-level generic files
#
/linux
/modules-only.symvers
/vmlinux
/vmlinux.32
/vmlinux.map
/vmlinux.symvers
/vmlinux-gdb.py
/vmlinuz
/System.map
/Module.markers
/modules.builtin
/modules.builtin.modinfo
/modules.nsdeps

#
# RPM spec file (make rpm-pkg)
#
/rpmbuild/

#
# Debian directory (make deb-pkg)
#
/debian/

#
# Snap directory (make snap-pkg)
#
/snap/

#
# tar directory (make tar*-pkg)
#
/tar-install/

#
# We don't want to ignore the following even if they are dot-files
#
!.clang-format
!.cocciconfig
!.editorconfig
!.get_maintainer.ignore
!.gitattributes
!.gitignore
!.kunitconfig
!.mailmap
!.rustfmt.toml

#
# Generated include files
#
/include/config/
/include/generated/
/arch/*/include/generated/

# stgit generated dirs
patches-*

# quilt's files
patches
series

# ctags files
#
# NOTE: 上游写作 `tags`，会连带排除名为 tags 的目录。
# 本仓库中 tools/testing/selftests/arm64/tags/ 是一个真实源码目录
# （arm64 内存标签测试），因此改为只忽略仓库根的同名产物。
/tags
/TAGS
# 同时显式放行该源码目录（目录本身必须先 negate，其内容才能入库）
!tools/testing/selftests/arm64/tags/
!tools/testing/selftests/arm64/tags/**

# cscope files
cscope.*
ncscope.*

# gnu global files
GPATH
GRTAGS
GSYMS
GTAGS

# id-utils files
ID

*.orig
*~
\#*#

#
# Leavings from module signing
#
extra_certificates
signing_key.pem
signing_key.priv
signing_key.x509
x509.genkey

# Kconfig presets
/all.config
/alldef.config
/allmod.config
/allno.config
/allrandom.config
/allyes.config

# Kconfig savedefconfig output
/defconfig

# Kdevelop4
*.kdev4

# Clang's compilation database file
/compile_commands.json

# Documentation toolchain
sphinx_*/

# Rust analyzer configuration
/rust-project.json

# --- Yat_CAShed project ignores ---
# Build/test logs and artifacts
*.log
# 例外：kunit 的 test_data/*.log 是测试输入数据（期望输出快照），
# 不是构建日志，必须入库，否则 kunit 用例无法运行。
!/tools/testing/kunit/test_data/*.log
/cache_test

# Prebuilt initramfs / test-chroot binaries (regenerated by yat_test_scripts)
/initramfs/bin/
/initramfs_fixed/bin/
/initramfs_fixed/etc/
/initramfs_fixed/lib/
/initramfs_fixed/lib64/
/test_chroot/bin/
/test_chroot/lib/
/test_chroot/lib64/
#### yat_simple_test_env/ 完全由 build_yat_simple_test.sh 生成（脚本会先 rm -rf 再重建），
#### 其中的 init 也是 heredoc 现写的；整目录不入库，避免「脚本删掉被跟踪的文件」。
/yat_simple_test_env/
#### test_with_programs_* 是 create_test_initramfs.sh 的临时目录
####   _build/     —— 编译产物（二进制），保证 boot_test_scripts/ 物理上只有 .c
####   _initramfs/ —— cpio 归档用的目录树
/test_with_programs_build/
/test_with_programs_initramfs/
/test_with_programs.cpio.gz

# QEMU 对比实验产物（compare_cfs_vs_yat.sh）
/yat_test_scripts/results/
/yat_test_scripts/*.log

# Compiled user-space test programs
# 约定：boot_test_scripts/ 只放 C 源码，编译产物（与 .c 同名的可执行文件）一律不入库。
/boot_test_scripts/yat_simple_test
/boot_test_scripts/yat_bench
### 注意：yat_bench 是二进制的名字，yat_bench.c 是源码，二者不同名文件互不影响。
/test_visualization/debug_scheduler
/test_visualization/performance_test
