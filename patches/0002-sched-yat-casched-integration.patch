 /* Can be ORed in to make sure the process is reverted back to SCHED_NORMAL on fork */
 #define SCHED_RESET_ON_FORK     0x40000000
 
--- a/init/Kconfig
+++ b/init/Kconfig
@@ -849,6 +849,23 @@
 
 	  If in doubt, use the default value.
 
+config SCHED_CLASS_YAT_CASCHED
+	bool "Yat_CASched cache-aware scheduling class"
+	depends on SMP
+	default n
+	help
+	  Enable the Yat_CASched scheduling class (SCHED_YAT_CASCHED, policy
+	  number 8), an experimental cache-aware scheduling class built around
+	  job/DAG level placement instead of per-task placement.
+
+	  The class is inserted into the sched_class chain between fair and
+	  idle. Enabling it lets tasks opt in with
+	  sched_setscheduler(..., SCHED_YAT_CASCHED, ...); ordinary
+	  SCHED_OTHER/SCHED_FIFO tasks keep using the stock classes.
+
+	  This is research code: there is no upstream support for it, and it is
+	  not tested against every architecture. If in doubt, say N.
+
 endmenu
 
