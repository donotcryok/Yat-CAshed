 #endif
@@ -4785,6 +4836,17 @@
 
 	if (dl_prio(p->prio))
 		return -EAGAIN;
+#ifdef CONFIG_SCHED_CLASS_YAT_CASCHED
+	/*
+	 * 子任务继承父任务的调度类。上游这里只按 prio 区间在 RT/CFS 之间
+	 * 二选一，对自定义的普通调度类是错的：yat 任务 fork 出的子任务会
+	 * 被降级成 CFS，此后既不走 yat 的 enqueue/select_task_rq，也让
+	 * 「同族任务同策略」的前提失效。策略写在 p->policy 上（fork 已
+	 * 继承），这里按策略判定即可。
+	 */
+	else if (yat_casched_policy(p->policy))
+		p->sched_class = &yat_casched_sched_class;
+#endif
 	else if (rt_prio(p->prio))
 		p->sched_class = &rt_sched_class;
 	else
@@ -7064,6 +7126,16 @@
 {
 	if (dl_prio(prio))
 		p->sched_class = &dl_sched_class;
+#ifdef CONFIG_SCHED_CLASS_YAT_CASCHED
+	/*
+	 * 必须排在 rt_prio() 之前判断：yat 策略下 prio 由 __normal_prio()
+	 * 映射到普通区间，但这里的判定不应依赖调用方送进来的 prio 落在
+	 * 哪个区间 —— 策略才是唯一的真相来源。顺序颠倒会让 yat 任务被
+	 * 静默塞进 rt_sched_class（A8 实测踩到过，见 __normal_prio 注释）。
+	 */
+	else if (yat_casched_policy(p->policy))
+		p->sched_class = &yat_casched_sched_class;
+#endif
 	else if (rt_prio(prio))
 		p->sched_class = &rt_sched_class;
 	else
@@ -7663,6 +7735,18 @@
 			goto req_priv;
 	}
 
+	/*
+	 * YAT_CASCHED policy: Allow priority changes without CAP_SYS_NICE
+	 * for same owner, similar to normal scheduling policies
+	 */
+	if (yat_casched_policy(policy)) {
+		/* Only check same owner for YAT_CASCHED */
+		if (!check_same_owner(p))
+			goto req_priv;
+		/* Skip other privilege checks for YAT_CASCHED */
+		goto skip_priv_checks;
+	}
+
 	/* Can't change other user's priorities: */
 	if (!check_same_owner(p))
 		goto req_priv;
@@ -7671,6 +7755,8 @@
 	if (p->sched_reset_on_fork && !reset_on_fork)
 		goto req_priv;
 
+skip_priv_checks:
+
